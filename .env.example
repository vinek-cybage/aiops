# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# ── aiops-db (shared Postgres: incidents, teams/users, telemetry) ────────────
POSTGRES_USER=aiops
POSTGRES_PASSWORD=aiops
POSTGRES_DB=aiops
POSTGRES_HOST_PORT=5432

# ── langfuse (hosted Langfuse Cloud, not a local container) ───────────────────
# Sign up at https://cloud.langfuse.com (or https://us.cloud.langfuse.com for the US region),
# create a project, then fill these in from Settings -> API Keys.
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ── service ports ──────────────────────────────────────────────────────────
AIOPS_API_HOST_PORT=8000
TELEMETRY_API_HOST_PORT=5080

# ── aiops-backend (Bedrock / Claude) ───────────────────────────────────────
AWS_REGION=us-west-2
MODEL_ID=arn:aws:bedrock:us-west-2:997594557385:application-inference-profile/wdxqrgk9hynd
