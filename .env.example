# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# Set to "production" to make aiops-api refuse to start with dev-only default
# secrets (JWT_SECRET / CREDENTIAL_ENCRYPTION_KEY left unset) instead of just
# warning about them. Leave as "development" for local/demo use.
ENVIRONMENT=development

# ── aiops-db (shared Postgres: incidents, teams/users, telemetry) ────────────
POSTGRES_USER=aiops
POSTGRES_PASSWORD=aiops
POSTGRES_DB=aiops
POSTGRES_HOST_PORT=3111

# ── langfuse (hosted Langfuse Cloud, not a local container) ───────────────────
# Sign up at https://cloud.langfuse.com (or https://us.cloud.langfuse.com for the US region),
# create a project, then fill these in from Settings -> API Keys.
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ── service ports ──────────────────────────────────────────────────────────
# All host-published ports live in the 3111-3116 range to dodge collisions
# with whatever else (other projects, system services) already holds the
# conventional defaults (5432, 8000, 5080, 8080, 3100, 3000) on this machine.
PGADMIN_HOST_PORT=3112
AIOPS_API_HOST_PORT=3113
# Exposed to the host so external sources (e.g. the standalone shopfront repo)
# can reach telemetry-api without joining this stack's Docker network.
TELEMETRY_API_HOST_PORT=3114
LOKI_HOST_PORT=3115
GRAFANA_HOST_PORT=3116

# ── aiops-backend (Bedrock / Claude) ───────────────────────────────────────
# AWS_PROFILE must match a profile in your ~/.aws/config (mounted read-only into
# every Bedrock-calling container) — containers have no `default` profile to fall
# back to, so this must be set explicitly even though the host shell might not need it.
AWS_PROFILE=AI
AWS_REGION=us-west-2
MODEL_ID=arn:aws:bedrock:us-west-2:408336117462:inference-profile/us.anthropic.claude-sonnet-4-5-20250929-v1:0
# MODEL_ID=arn:aws:bedrock:us-west-2:997594557385:application-inference-profile/wdxqrgk9hynd

# ── webhook -> telemetry-api bridge (aiops-api writes fault logs here) ────────
TELEMETRY_API_URL=http://telemetry-api:8080
# Shared secret for same-network callers (aiops-api's webhook bridge) that have
# no per-team ingestion key — telemetry-api rejects every /api/* request that
# presents neither a valid ingestion key nor this token. Grants access across
# every org, so generate a real one for anything beyond local dev, e.g.:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEMETRY_INTERNAL_TOKEN=dev-only-internal-token-change-me

# ── remediation actions: "Raise PR" (leave blank to keep it simulated/disabled) ─
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_BASE_BRANCH=main

# ── auth (JWT access/refresh tokens) ──────────────────────────────────────────
# Generate a real secret for anything beyond local dev, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-secret-change-me
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# ── CORS: frontend origins allowed to send credentialed requests (comma-separated) ─
# The production build is served same-origin by aiops-api, so this is mainly for
# the Vite dev server (default http://localhost:5173).
ALLOWED_ORIGINS=http://localhost:5173

# ── credential encryption (MCP servers, data sources, GitHub integrations) ───
# Generate a real one for anything beyond local dev: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing this key makes every already-stored credential undecryptable — treat it like a database of its own.
CREDENTIAL_ENCRYPTION_KEY=
