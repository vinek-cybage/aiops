# ── Project specific ──────────────────────────────────────────────────────────
# Local Claude usage data — never commit real user data
data/
# Prometheus persistent storage
prometheus_data/
# Local app settings
db/app_settings.json
# Shared app log files scraped by Promtail (see observability/) — keep the
# directory itself tracked (via .gitkeep) so it exists on a fresh clone;
# Docker Desktop on Windows/WSL2 can't auto-create bind-mount source dirs
# the way native Linux does, so a missing dir here fails `docker compose up`.
observability/logs/*
!observability/logs/.gitkeep
